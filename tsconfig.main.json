{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "electron"],
    "tsBuildInfoFile": ".vite/tsconfig.main.tsbuildinfo"
  },
  "files": ["forge.config.ts", "vite.main.config.ts"],
  "include": [
    "src/main/**/*.ts",
    "src/shared/application/**/*.ts",
    "src/shared/contracts/**/*.ts",
    "src/shared/domain/**/*.ts",
    "src/shared/infrastructure/**/*.ts"
  ]
}
