{
  "name": "rumo",
  "version": "0.1.0",
  "private": true,
  "description": "ERP pessoal local-first para motoristas de aplicativo.",
  "author": "RUMO",
  "license": "UNLICENSED",
  "type": "module",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "electron-forge start",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "typecheck": "tsc --build tsconfig.main.json tsconfig.preload.json tsconfig.renderer.json --pretty false",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.0",
    "typescript": "6.0.3",
    "vite": "8.1.4"
  },
  "config": {
    "forge": "./forge.config.ts"
  }
}
